# Application Environment
NODE_ENV=production
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database & Cache (Docker Network Hosts)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/seatlock?schema=public
REDIS_URL=redis://redis:6379

# Authentication
JWT_SECRET=your_jwt_production_secret
JWT_ACCESS_SECRET=your_jwt_production_secret
REFRESH_TOKEN_SECRET=your_refresh_production_secret
JWT_REFRESH_SECRET=your_refresh_production_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Gateway (Active Test/Live Credentials)
RAZORPAY_KEY_ID=rzp_test_TtJ92DEuVzY4JL
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
