generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  bookings Booking[]
  idempotencyKeys IdempotencyKey[]
  waitlistEntries Waitlist[]
  refreshTokens RefreshToken[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  USER
  ADMIN
}

model Movie {
  id           String   @id @default(uuid())
  title        String
  description  String?
  durationMin  Int
  language     String
  genre        String
  releaseDate  DateTime?
  posterUrl    String?
  trailerUrl   String?
  isActive     Boolean  @default(true)
  shows        Show[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Theater {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  state       String
  isActive    Boolean  @default(true)
  screens     Screen[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Screen {
  id          String   @id @default(uuid())
  theaterId   String
  name        String
  totalSeats  Int
  isActive    Boolean  @default(true)

  theater     Theater  @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  seats       Seat[]
  shows       Show[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([theaterId])
}

model Show {
  id          String   @id @default(uuid())
  movieId     String
  screenId    String

  startTime   DateTime
  endTime     DateTime
  language    String
  basePrice   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)

  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  screen      Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  showSeats   ShowSeat[]
  bookings Booking[]
  waitlistEntries Waitlist[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([movieId])
  @@index([screenId])
  @@index([startTime])
}

model Seat {
  id          String   @id @default(uuid())
  screenId    String
  rowLabel    String
  seatNumber  Int
  seatType    SeatType @default(REGULAR)

  screen      Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  showSeats   ShowSeat[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([screenId, rowLabel, seatNumber])
  @@index([screenId])
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

enum ShowSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}


model ShowSeat {
  id            String          @id @default(uuid())
  showId        String
  seatId        String

  status        ShowSeatStatus  @default(AVAILABLE)
  holdToken     String?
  holdExpiresAt DateTime?
  version       Int             @default(0)
  price         Decimal         @db.Decimal(10, 2)

  show          Show            @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat          Seat            @relation(fields: [seatId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([holdExpiresAt])
}


model Booking {
  id              String        @id @default(uuid())
  userId          String
  showId          String

  status          BookingStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  bookingNumber   String        @unique

  expiresAt       DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?

  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  show            Show          @relation(fields: [showId], references: [id], onDelete: Restrict)
  bookingSeats    BookingSeat[]
  payments Payment[]
  bookingCoupons BookingCoupon[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([showId])
  @@index([status])
  @@index([expiresAt])
}

model BookingCoupon {
  id         String   @id @default(uuid())
  bookingId  String
  couponId   String
  discount   Decimal  @db.Decimal(10, 2)

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)

  createdAt  DateTime @default(now())

  @@unique([bookingId, couponId])
  @@index([couponId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model BookingSeat {
  id          String   @id @default(uuid())
  bookingId   String
  showSeatId  String

  price       Decimal  @db.Decimal(10, 2)

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showSeat    ShowSeat @relation(fields: [showSeatId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())

  @@unique([bookingId, showSeatId])
  @@index([showSeatId])
}


model Payment {
  id                    String        @id @default(uuid())
  bookingId             String

  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("INR")
  status                PaymentStatus @default(PENDING)

  stripePaymentIntentId String?       @unique
  stripeChargeId        String?

  paidAt                DateTime?
  failedAt              DateTime?

  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds               Refund[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}


model IdempotencyKey {
  id            String   @id @default(uuid())
  userId        String
  key           String
  requestHash   String
  responseBody  Json?
  statusCode    Int?
  expiresAt     DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, key])
  @@index([expiresAt])
}


enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}


model WebhookEvent {
  id             String   @id @default(uuid())
  provider       String
  eventId        String
  eventType      String
  payload        Json
  processed      Boolean  @default(false)
  processedAt    DateTime?
  errorMessage   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([processed])
}


enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String            @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus  @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  processedAt   DateTime?
  lastError     String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}


model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}


enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Refund {
  id             String       @id @default(uuid())
  paymentId      String
  amount         Decimal      @db.Decimal(10, 2)
  reason         String?
  status         RefundStatus @default(PENDING)
  stripeRefundId String?      @unique

  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([paymentId])
  @@index([status])
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  discountType   DiscountType
  discountValue  Decimal  @db.Decimal(10, 2)
  minAmount      Decimal? @db.Decimal(10, 2)
  maxDiscount    Decimal? @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int      @default(0)
  expiresAt      DateTime?
  isActive       Boolean  @default(true)

  bookingCoupons BookingCoupon[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@index([isActive])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}


model Waitlist {
  id          String   @id @default(uuid())
  userId      String
  showId      String
  position    Int
  notifiedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, showId])
  @@index([showId, position])
  @@index([isActive])
}


model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model FailedJob {
  id          String   @id @default(uuid())
  queueName   String
  jobId       String
  jobName     String
  payload     Json?
  error       String
  attempts    Int      @default(0)
  failedAt    DateTime @default(now())
  resolvedAt  DateTime?

  createdAt   DateTime @default(now())

  @@unique([queueName, jobId])
  @@index([queueName])
  @@index([failedAt])
}